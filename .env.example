# Copy to .env. Secrets only — all behaviour lives in config.yaml.

# Travelpayouts Data API token — OPTIONAL and default-off (E0 measured its
# signal as unusable on this market; the radar runs identically without it).
TRAVELPAYOUTS_TOKEN=

# SearchApi.io key (hosted Google Flights API) — optional verify backup.
# Free signup grants ~100 one-time credits; paid ~$40/mo = 10k searches
# would cover the whole sampler+verify if fast-flights ever breaks down.
SEARCHAPI_KEY=

# Coming with E3 (Home Assistant / MQTT integration):
# MQTT_HOST=
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
