# Copy to .env. Secrets only — all behaviour lives in config.yaml.

# Travelpayouts Data API token — OPTIONAL and default-off (E0 measured its
# signal as unusable on this market; the radar runs identically without it).
TRAVELPAYOUTS_TOKEN=

# Hosted Google-Flights SERP APIs — optional verify backups (either or both).
# SerpApi.com free plan: 250 searches/month recurring — can carry the whole
# verify stage (~8/day) by itself.
SERPAPI_KEY=
# SearchApi.io: ~100 one-time free credits; paid ~$40/mo = 10k searches would
# cover the entire sampler+verify if fast-flights ever breaks down.
SEARCHAPI_KEY=

# Coming with E3 (Home Assistant / MQTT integration):
# MQTT_HOST=
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Home Assistant webhook for deal alerts — OPTIONAL. Create an automation with
# a "Webhook" trigger in HA, then paste its full URL here:
#   https://<your-ha-host>/api/webhook/<webhook-id>
# Without it the radar runs normally and simply sends nothing.
HA_WEBHOOK_URL=
